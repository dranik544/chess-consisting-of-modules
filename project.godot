"class": "ModLoaderDeprecated",
"language": "GDScript",
"path": "res://addons/mod_loader/api/deprecated.gd"
}, {
"base": "Node",
"class": "ModLoaderLog",
"language": "GDScript",
"path": "res://addons/mod_loader/api/log.gd"
}, {
